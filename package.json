{
  "name": "rudow-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Rudow — let your AI assistant query your app's logs, metrics and incidents.",
  "mcpName": "io.github.prenzio/rudow-mcp-server",
  "license": "MIT",
  "author": "Rudow",
  "homepage": "https://rudow.ai/docs/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prenzio/rudow-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "rudow",
    "logs",
    "observability",
    "monitoring"
